# copy to .env.docker and fill in; used by docker-compose.yml only

# letters and digits only, because it is placed inside a connection URL
POSTGRES_PASSWORD=
POSTGRES_DB={{crate_name}}
# at least 32 random characters
JWT_SECRET=

WEB_PORT=8080
API_PORT=8081
# "development" also serves the API docs on the API port
APP_ENV=production
