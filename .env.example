HOST=127.0.0.1
PORT=3000
# scripts/new-env replaces __DB_PASSWORD__; the database is created on first run
# and tests use the same name plus "_test"
DATABASE_URL="postgres://{{db_user}}:__DB_PASSWORD__@{{db_host}}:{{db_port}}/{{ db_name | default: crate_name }}"
# 1 starts one process per core; Linux only, needs `--features prefork`
PREFORK=0

# at least 32 random characters, never commit the real one
JWT_SECRET=
# tokens carry these and are rejected when they differ
JWT_ISSUER={{project-name}}
JWT_AUDIENCE={{project-name}}-client

# Swagger UI is served only for "development"; remove or change it in production
APP_ENV=development
# 1 opens Swagger UI in the default browser at startup; needs APP_ENV=development
OPEN_DOCS=1
# browser origins allowed to call the API, comma separated; empty allows none
CORS_ORIGINS=http://localhost:5173
# requests per minute and client address on /auth; 0 turns the limit off
AUTH_RATE_LIMIT=10
