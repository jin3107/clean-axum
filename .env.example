HOST=127.0.0.1
PORT=3000
{%- case database %}
{%- when "postgres" %}
DATABASE_URL="postgres://postgres:postgres@localhost:5432/{{crate_name}}"
{%- when "mysql" %}
DATABASE_URL="mysql://user:password@localhost:3306/{{crate_name}}"
{%- else %}
DATABASE_URL="sqlite://dev.db"
{%- endcase %}
# 1 starts one process per core; Linux only, needs `--features prefork`
PREFORK=0

# at least 32 random characters, never commit the real one
JWT_SECRET=
