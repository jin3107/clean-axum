HOST=127.0.0.1
PORT=3000
# the database is created on first run; tests use the same name plus "_test"
DATABASE_URL="postgres://postgres:postgres@localhost:5432/clean_axum"
# 1 starts one process per core; Linux only, needs `--features prefork`
PREFORK=0

# at least 32 random characters, never commit the real one
JWT_SECRET=
